# Copy to backend/.env and edit. All values are optional.

# SQLite (default, zero setup): a file at backend/meetops.db
# DATABASE_URL=sqlite:///./meetops.db

# PostgreSQL via docker compose (see backend/docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://meetops:meetops@localhost:5432/meetops

# Signs login tokens. Use a long random value for any shared deployment.
# SECRET_KEY=change-me-to-a-long-random-string
# TOKEN_HOURS=12

# Rule layer after the classifier, and the confidence above which items skip review
# USE_RULES=true
# AUTO_CONFIRM_CONFIDENCE=0.8

# Owner / deadline extraction: rules | spacy | hybrid (default)
# EXTRACTION_ENGINE=hybrid

# Folder for a specific classifier version (default: newest under ml/models/)
# MODEL_DIR=../ml/models/v3

# Seconds to pause between pipeline stages so the progress UI is visible (0 to disable)
# PIPELINE_STAGE_DELAY=0.4
