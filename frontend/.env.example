# Copy to .env.local and adjust if needed.

# Base URL of the MeetOps API. Leave unset in development: Vite proxies /api
# to http://localhost:8000 (see vite.config.ts). Set it for production builds,
# e.g. VITE_API_URL=https://meetops.example.com/api
# VITE_API_URL=

# Where the dev-server proxy sends /api requests (default http://localhost:8000).
# VITE_PROXY_TARGET=http://localhost:8000
